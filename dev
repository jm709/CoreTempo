#!/usr/bin/env bash
# CoreTempo launcher. Run from anywhere: ./dev [mode] [args]
#
#   ./dev              desktop app (Svelte dev server + Rust core in one process)
#   ./dev headless     coretempod against ./tempo.toml
#   ./dev headless F   coretempod against workflow file F
#   ./dev check        every gate: rust tests, clippy, fmt, svelte-check, lint, vitest, client tsc/oxlint/vitest
#   ./dev live         the real-claude round trip (#3): needs a logged-in claude, spends tokens
#
# The desktop app embeds the backend: Tauri starts vite (via beforeDevCommand in
# tauri.conf.json) and the Rust core runs in-process. There is no separate
# backend server to launch unless you want the headless daemon.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP="$ROOT/app"
CLIENT="$ROOT/clients/js"

have() { command -v "$1" >/dev/null 2>&1; }

die() {
  printf 'error: %s\n' "$1" >&2
  exit 1
}

ensure_deps() {
  have pnpm || die "pnpm not found. Install with: corepack enable && corepack prepare pnpm@latest --activate"
  if [ ! -d "$APP/node_modules" ]; then
    printf '==> installing webview dependencies\n'
    (cd "$APP" && pnpm install)
  fi
  if [ ! -d "$CLIENT/node_modules" ]; then
    printf '==> installing client dependencies\n'
    (cd "$CLIENT" && pnpm install)
  fi
}

# Tauri needs webkit2gtk/gtk at compile time; failing here beats a 200-line
# build-script backtrace.
ensure_gui_libs() {
  have pkg-config || die "pkg-config not found. Install: sudo apt-get install -y pkg-config"
  if ! pkg-config --exists webkit2gtk-4.1 gtk+-3.0; then
    die "missing Tauri system libraries. Install:
  sudo apt-get install -y libwebkit2gtk-4.1-dev libgtk-3-dev \\
    libayatana-appindicator3-dev librsvg2-dev build-essential pkg-config"
  fi
}

run_app() {
  ensure_deps
  ensure_gui_libs
  printf '==> building coretempod (sessions daemon for the desktop)\n'
  cargo build -p coretempo-daemon --manifest-path "$ROOT/Cargo.toml"
  export CORETEMPOD_BIN="$ROOT/target/debug/coretempod"
  # No DRM device (common on WSL without GPU passthrough) means MESA has no
  # physical device to pick: it tries ZINK, fails, and floods stderr with
  # libEGL/dri2 errors. Force the software rasterizer instead.
  if [ ! -d /dev/dri ] && [ -z "${LIBGL_ALWAYS_SOFTWARE:-}" ]; then
    export LIBGL_ALWAYS_SOFTWARE=1
    printf '==> no GPU device: LIBGL_ALWAYS_SOFTWARE=1 (software rendering)\n'
  fi
  if [ -n "${WSL_DISTRO_NAME:-}" ]; then
    # Under WSLg, webkitgtk's Wayland surface never becomes visible: the process
    # runs but no window maps. X11 (via XWayland) shows it correctly.
    [ -z "${GDK_BACKEND:-}" ] && export GDK_BACKEND=x11
    # WSLg's DMABUF path also glitches under webkitgtk.
    [ -z "${WEBKIT_DISABLE_DMABUF_RENDERER:-}" ] && export WEBKIT_DISABLE_DMABUF_RENDERER=1
    printf '==> WSL detected: GDK_BACKEND=x11, WEBKIT_DISABLE_DMABUF_RENDERER=1\n'
  fi
  printf '==> starting CoreTempo (vite :1420 + Rust core)\n'
  cd "$APP" && exec pnpm tauri dev "$@"
}

run_headless() {
  local config="${1:-$ROOT/tempo.toml}"
  [ -f "$config" ] || die "no workflow file at $config
Copy the example to get started:  cp $ROOT/tempo.example.toml $ROOT/tempo.toml"
  printf '==> building coretempod\n'
  cargo build -p coretempo-daemon --manifest-path "$ROOT/Cargo.toml"
  printf '==> running workflow %s\n' "$config"
  exec "$ROOT/target/debug/coretempod" run "$config"
}

run_check() {
  ensure_deps
  cd "$ROOT"
  printf '==> cargo test\n' && cargo test --workspace
  printf '==> cargo clippy\n' && cargo clippy --workspace --all-targets --all-features -- -D warnings
  printf '==> cargo fmt\n' && cargo fmt --check
  cd "$APP"
  printf '==> svelte-check\n' && pnpm exec svelte-check --threshold error
  printf '==> oxlint\n' && pnpm exec oxlint src
  printf '==> vitest\n' && pnpm exec vitest run
  cd "$CLIENT"
  printf '==> client tsc\n' && pnpm exec tsc --noEmit
  printf '==> client oxlint\n' && pnpm exec oxlint src
  printf '==> client vitest\n' && pnpm exec vitest run
  printf '\nall gates passed\n'
}

run_live() {
  cd "$ROOT"
  printf '==> cargo build --workspace (agents get the tempo beside coretempod)\n'
  cargo build --workspace
  printf '==> live claude test\n'
  cargo test -p coretempo-daemon --test live_claude -- --ignored --nocapture
  printf '==> live sessions test\n'
  cargo test -p coretempo-daemon --test live_sessions -- --ignored --nocapture
}

case "${1:-app}" in
app) shift $(($# > 0 ? 1 : 0)) && run_app "$@" ;;
headless) shift && run_headless "$@" ;;
live) run_live ;;
check) run_check ;;
-h | --help | help)
  sed -n '2,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  ;;
*) die "unknown mode '$1' (expected: app, headless, check, live)" ;;
esac
