{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoreTempo",
  "version": "1.0.0",
  "identifier": "dev.coretempo.app",
  "mainBinaryName": "coretempo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CoreTempo",
        "width": 1440,
        "height": 900,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
